module game

import open from render.ui
import poll from render.ui
import close from render.ui
import elapsed_seconds from render.ui

import LifeSupport from systems
import SolarGenerator from systems
import Base from outpost

import BaseUIState from base_ui
import update_base_ui from base_ui_input
import draw_shackleton_view from shackleton_view

// Composition root: gameplay state stays separate from presentation state.
let base = Base(SolarGenerator(), LifeSupport())
let base_ui = BaseUIState()

if open("Space Game - Shackleton Base", 1280, 800) {
  let running = true
  let simulated_second = 0.0
  while running {
    if poll() == false { running = false }
    if running {
      let now: Float64 = elapsed_seconds()

      // Rendering-owned input and temporary presentation data.
      update_base_ui(base_ui, now)

      // Owner-authored gameplay model. The presentation adapter will replace
      // the UI fixture when the real resource contracts are ready.
      while simulated_second + 1.0 <= now {
        base.runMandatorySystems(1.0 second)
        simulated_second = simulated_second + 1.0
      }

      draw_shackleton_view(base_ui)
    }
  }
  close()
}
