module main

class BaseState {
  let durability: Int
  let stored_charge: Float<watt * second>
  let water_supply: Float<kilogram>
  let food_supply: Float<kilogram>
  let oxygen_supply: Float<kilogram>

  new() {
    self.durability = 100
    self.stored_charge = 0 (watt * second)
    self.water_supply = 100 kilogram
    self.food_supply = 100 kilogram
    self.oxygen_supply = 100 kilogram
  }

  fun advance!(delta_time: Float<second>): Void {
    let population: Float<person> = 10 person
    let generation_rate: Float<watt> = 100 watt
    let power_use: Float<watt> = 75 watt
    let water_use: Float<kilogram / second / person> =
      1 (kilogram / second / person)
    let food_use: Float<kilogram / second / person> =
      1 (kilogram / second / person)
    let oxygen_use: Float<kilogram / second / person> =
      1 (kilogram / second / person)

    self.stored_charge += (generation_rate - power_use) * delta_time
    self.water_supply -= water_use * population * delta_time
    self.food_supply -= food_use * population * delta_time
    self.oxygen_supply -= oxygen_use * population * delta_time
  }

  fun print_status(): Void {
    print("STATUS")
    print("  Charge: ${self.stored_charge}")
    print("  h2o: ${self.water_supply}")
    print("  Food: ${self.food_supply}")
    print("  O2: ${self.oxygen_supply}")
  }

  fun durability_value(): Int => self.durability
  fun charge(): Float<watt * second> => self.stored_charge
  fun water(): Float<kilogram> => self.water_supply
  fun food(): Float<kilogram> => self.food_supply
  fun oxygen(): Float<kilogram> => self.oxygen_supply
}

let shackleton_base = BaseState()

fun advance_base(delta_time: Float<second>): Void {
  shackleton_base.advance!(delta_time)
}

fun print_base_status(): Void { shackleton_base.print_status() }
fun base_durability(): Int => shackleton_base.durability_value()
fun base_charge(): Float<watt * second> => shackleton_base.charge()
fun base_water(): Float<kilogram> => shackleton_base.water()
fun base_food(): Float<kilogram> => shackleton_base.food()
fun base_oxygen(): Float<kilogram> => shackleton_base.oxygen()

export advance_base
export print_base_status
export base_durability
export base_charge
export base_water
export base_food
export base_oxygen
