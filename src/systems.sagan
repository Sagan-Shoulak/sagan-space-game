module systems

import Degradable from faces
import Powered from faces

class System has Degradable {
  new() {
    self.durability = 100
  }
}


class LifeSupport is System, has Powered {
  let h2o_usage: Float<kilogram / second>  = 1 (kilogram / second)
  let food_usage: Float<kilogram / second> = 1 (kilogram / second) // TODO: Move to base usage directly
  let o2_usage: Float<kilogram / second>   = 1 (kilogram / second)
  
  new() {
    self.powerUsage = 75 watt
  }
}


class Generator is System {
  let generationRate: Float<watt>
  
  new() {
    self.generationRate = 100 watt
  }
}


class SolarGenerator is Generator {
  new() {
  }
}

export System
export LifeSupport
export Generator
export SolarGenerator