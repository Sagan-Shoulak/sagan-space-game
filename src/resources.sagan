module resources

enum MassiveResource {
  oxygen
  hydrogen
  water
  food
  iron
  carbon
  carbonDioxide
  steel
}

const EMPTY_MASSIVE_RESOURCES: Dictionary<MassiveResource, Float64<kilogram>> = {
  MassiveResource.oxygen:        0.0 kilogram,
  MassiveResource.hydrogen:      0.0 kilogram,
  MassiveResource.water:         0.0 kilogram,
  MassiveResource.food:          0.0 kilogram,
  MassiveResource.iron:          0.0 kilogram,
  MassiveResource.carbon:        0.0 kilogram,
  MassiveResource.carbonDioxide: 0.0 kilogram,
  MassiveResource.steel:         0.0 kilogram
}

class ResourceBundle {
  let storedCharge: Float64<watt * hour>
  let massiveResources: Dictionary<MassiveResource, Float64<kilogram>>


  new(storedCharge: Float64<watt * hour>, massiveResources: Dictionary<MassiveResource, Float64<kilogram>>) {
    self.storedCharge = storedCharge
    self.massiveResources = { ...EMPTY_MASSIVE_RESOURCES, ...massiveResources}
  }

  fun +=(other: ResourceBundle): Void {
    self.storedCharge += other.storedCharge
    for resource in MassiveResource {
      self.massiveResources[resource] += other.massiveResources[resource]
    }
  }

  fun -=(other: ResourceBundle): Void {
    self.storedCharge -= other.storedCharge
    for resource in MassiveResource {
      self.massiveResources[resource] -= other.massiveResources[resource]
    }
  }

  fun +(other: ResourceBundle): ResourceBundle {
    let newBundle = copy self

    newBundle += other

    return newBundle
  }

  fun -(other: ResourceBundle): ResourceBundle {
    let newBundle = copy self

    newBundle -= other

    return newBundle
  }
  
  fun canAfford(other: ResourceBundle): Bool {
    let hasCharge = self.storedCharge >= other.storedCharge

    let hasMassiveResources = MassiveResource.all(
      fun(resource: MassiveResource): Bool => 
        self.massiveResources[resource] >= other.massiveResources[resource]
      )

    return hasCharge and hasMassiveResources
  } 
}

print("\nDEMO\n")

export MassiveResource
export ResourceBundle
