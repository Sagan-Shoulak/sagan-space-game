module resources

enum MassiveResource {
  oxygen
  hydrogen
  water
  food
  iron
  carbon
  carbonDioxide
  steel
}

// watt hours for stored charge

class ResourceBundle {
  let storedCharge: Float64<watt * hour>
  let massiveResources: Dictionary<MassiveResource, Float64<kilogram>>

  new(
    storedCharge: Float64<watt * hour> = 0 (watt * hour),
    oxygen: Float64<kilogram> = 0 (kilogram),
    hydrogen: Float64<kilogram> = 0 (kilogram),
    water: Float64<kilogram> = 0 (kilogram),
    food: Float64<kilogram> = 0 (kilogram),
    iron: Float64<kilogram> = 0 (kilogram),
    carbon: Float64<kilogram> = 0 (kilogram),
    carbonDioxide: Float64<kilogram> = 0 (kilogram),
    steel: Float64<kilogram> = 0 (kilogram)
  ) {
    self.storedCharge = storedCharge
    self.massiveResources = {
      (MassiveResource.oxygen): oxygen,
      (MassiveResource.hydrogen): hydrogen,
      (MassiveResource.water): water,
      (MassiveResource.food): food,
      (MassiveResource.iron): iron,
      (MassiveResource.carbon): carbon,
      (MassiveResource.carbonDioxide): carbonDioxide,
      (MassiveResource.steel): steel
    }
  }

  new(storedCharge: Float64<watt * hour>,
      massiveResources: Dictionary<MassiveResource, Float64<kilogram>>) {
    self.storedCharge = storedCharge
    self.massiveResources = massiveResources
  }

  fun +=(other: ResourceBundle): Void {
    self.storedCharge += other.storedCharge
    for resource in MassiveResource {
      self.massiveResources[resource] += other.massiveResources[resource]
    }
  }

  fun +(other: ResourceBundle): ResourceBundle {
    let newBundle = ResourceBundle(
      self.storedCharge,
      self.massiveResources[MassiveResource.oxygen],
      self.massiveResources[MassiveResource.hydrogen],
      self.massiveResources[MassiveResource.water],
      self.massiveResources[MassiveResource.food],
      self.massiveResources[MassiveResource.iron],
      self.massiveResources[MassiveResource.carbon],
      self.massiveResources[MassiveResource.carbonDioxide],
      self.massiveResources[MassiveResource.steel]
    )

    newBundle += other

    return newBundle
  }

  fun -=(other: ResourceBundle): Void {
    self.storedCharge -= other.storedCharge
    for resource in MassiveResource {
      self.massiveResources[resource] -= other.massiveResources[resource]
    }
  }

  fun -(other: ResourceBundle): ResourceBundle {
    let newBundle = ResourceBundle(
      self.storedCharge,
      self.massiveResources[MassiveResource.oxygen],
      self.massiveResources[MassiveResource.hydrogen],
      self.massiveResources[MassiveResource.water],
      self.massiveResources[MassiveResource.food],
      self.massiveResources[MassiveResource.iron],
      self.massiveResources[MassiveResource.carbon],
      self.massiveResources[MassiveResource.carbonDioxide],
      self.massiveResources[MassiveResource.steel]
    )

    newBundle -= other

    return newBundle
  }
  
  fun canAfford(other: ResourceBundle): Bool {
    if self.storedCharge < other.storedCharge { return false }

    for resource in MassiveResource {
      if self.massiveResources[resource] < other.massiveResources[resource] { return false }
    }

    return true
  }
}

export MassiveResource
export ResourceBundle
