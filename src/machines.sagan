module machines

import ResourceCatalog from resources
import MaterialStack from resources
import MaterialInventory from resources
import EnergyStore from resources
import REGOLITH from resources

import RecipeDefinition from recipes

const MACHINE_IDLE: Int64 = 0
const MACHINE_PROCESSING: Int64 = 1
const MACHINE_OUTPUT_BLOCKED: Int64 = 2

/// A base-owned processing machine. It never owns a clock or updates itself;
/// the base supplies elapsed gameplay time, storage, and energy every tick.
class ProcessingMachine {
  let recipe_value: RecipeDefinition
  let batch_mass_value: Float64<kilogram>
  let throughput_value: Float64<kilogram / second>
  let power_demand_value: Float64<watt>
  let state_value: Int64
  let processed_mass_value: Float64<kilogram>

  new(recipe: RecipeDefinition, batch_mass: Float64<kilogram>,
      throughput: Float64<kilogram / second>, power_demand: Float64<watt>) {
    assert(recipe.inputs().total_mass() > 0.0 kilogram,
           "A machine recipe must consume material")
    assert(batch_mass > 0.0 kilogram, "Machine batch mass must be positive")
    assert(throughput > 0.0 (kilogram / second),
           "Machine throughput must be positive")
    assert(power_demand >= 0.0 watt, "Machine power demand must be non-negative")
    self.recipe_value = recipe
    self.batch_mass_value = batch_mass
    self.throughput_value = throughput
    self.power_demand_value = power_demand
    self.state_value = MACHINE_IDLE
    self.processed_mass_value = 0.0 kilogram
  }

  fun recipe(): RecipeDefinition => self.recipe_value
  fun batch_mass(): Float64<kilogram> => self.batch_mass_value
  fun throughput(): Float64<kilogram / second> => self.throughput_value
  fun power_demand(): Float64<watt> => self.power_demand_value
  fun state(): Int64 => self.state_value
  fun is_idle(): Bool => self.state_value == MACHINE_IDLE
  fun is_processing(): Bool => self.state_value == MACHINE_PROCESSING
  fun output_blocked(): Bool => self.state_value == MACHINE_OUTPUT_BLOCKED
  fun processed_mass(): Float64<kilogram> => self.processed_mass_value
  fun progress(): Float64 => self.processed_mass_value / self.batch_mass_value

  fun batch_scale(): Float64 =>
    self.batch_mass_value / self.recipe_value.inputs().total_mass()

  /// Recipe changes are allowed only while no inputs or outputs are held.
  fun set_recipe!(recipe: RecipeDefinition): Bool {
    if self.state_value != MACHINE_IDLE { return false }
    if recipe.inputs().total_mass() <= 0.0 kilogram { return false }
    self.recipe_value = recipe
    return true
  }

  fun inputs_available(inventory: MaterialInventory): Bool {
    let catalog = ResourceCatalog()
    let scale = self.batch_scale()
    let index: Int64 = 0
    while index < catalog.count() {
      let definition = catalog.definition(index)
      let required = self.recipe_value.inputs().amount(definition) * scale
      if inventory.contains(definition, required) == false { return false }
      index += 1
    }
    return true
  }

  fun reserve_inputs!(inventory: MaterialInventory): Bool {
    if self.state_value != MACHINE_IDLE { return false }
    if self.inputs_available(inventory) == false { return false }
    let catalog = ResourceCatalog()
    let scale = self.batch_scale()
    let index: Int64 = 0
    while index < catalog.count() {
      let definition = catalog.definition(index)
      let required = self.recipe_value.inputs().amount(definition) * scale
      if required > 0.0 kilogram {
        assert(inventory.remove!(definition, required),
               "Reserved recipe input disappeared during an atomic withdrawal")
      }
      index += 1
    }
    self.processed_mass_value = 0.0 kilogram
    self.state_value = MACHINE_PROCESSING
    return true
  }

  fun output_mass(): Float64<kilogram> =>
    self.recipe_value.outputs().total_mass() * self.batch_scale()

  fun output_can_fit(inventory: MaterialInventory): Bool {
    let regolith_output = self.recipe_value.outputs().amount(
      ResourceCatalog().definition(REGOLITH))
    if regolith_output > 0.0 kilogram { return false }
    return inventory.available_capacity() >= self.output_mass()
  }

  fun deposit_outputs!(inventory: MaterialInventory): Bool {
    if self.state_value != MACHINE_OUTPUT_BLOCKED { return false }
    if self.output_can_fit(inventory) == false { return false }
    let catalog = ResourceCatalog()
    let scale = self.batch_scale()
    let index: Int64 = 0
    while index < catalog.count() {
      let definition = catalog.definition(index)
      let produced = self.recipe_value.outputs().amount(definition) * scale
      if produced > 0.0 kilogram {
        assert(inventory.add!(MaterialStack(definition, produced)),
               "Recipe output no longer fit after an atomic capacity check")
      }
      index += 1
    }
    self.processed_mass_value = 0.0 kilogram
    self.state_value = MACHINE_IDLE
    return true
  }

  fun update!(delta_time: Float64<second>, inventory: MaterialInventory,
              energy: EnergyStore): Void {
    assert(delta_time >= 0.0 second, "Machine update time must be non-negative")

    if self.state_value == MACHINE_OUTPUT_BLOCKED {
      self.deposit_outputs!(inventory)
      return
    }

    if self.state_value == MACHINE_IDLE {
      if self.reserve_inputs!(inventory) == false { return }
    }

    let remaining_mass = self.batch_mass_value - self.processed_mass_value
    let remaining_time = remaining_mass / self.throughput_value
    let operating_time = delta_time
    if operating_time > remaining_time { operating_time = remaining_time }
    let required_energy = self.power_demand_value * operating_time

    // A power shortfall pauses the machine without losing reserved inputs.
    if energy.consume!(required_energy) == false { return }

    self.processed_mass_value += self.throughput_value * operating_time
    if self.processed_mass_value >= self.batch_mass_value {
      self.processed_mass_value = self.batch_mass_value
      self.state_value = MACHINE_OUTPUT_BLOCKED
      self.deposit_outputs!(inventory)
    }
  }
}

export ProcessingMachine
export MACHINE_IDLE
export MACHINE_PROCESSING
export MACHINE_OUTPUT_BLOCKED
